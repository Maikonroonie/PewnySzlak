# Eksport aplikacji web (Expo → statyczne pliki) serwowany przez nginx.
FROM node:24-bookworm-slim AS build
ARG EXPO_PUBLIC_API_URL=http://localhost:4000
ARG EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL \
    EXPO_PUBLIC_MAP_STYLE_URL=$EXPO_PUBLIC_MAP_STYLE_URL \
    CI=1
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/mobile/package.json apps/mobile/
COPY packages/domain/package.json packages/domain/
RUN npm ci --workspace=@pewnyszlak/mobile --workspace=@pewnyszlak/domain --include-workspace-root=false
COPY packages/domain packages/domain
COPY apps/mobile apps/mobile
COPY tsconfig.base.json ./
WORKDIR /app/apps/mobile
RUN npx expo export --platform web --output-dir dist

FROM nginx:1.27-alpine
COPY --from=build /app/apps/mobile/dist /usr/share/nginx/html
# Aplikacja jednostronicowa – każdy adres zwraca index.html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri/ /index.html; }\n  location /_expo/ { add_header Cache-Control "public, max-age=31536000, immutable"; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
