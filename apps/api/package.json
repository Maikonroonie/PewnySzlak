{
  "name": "@pewnyszlak/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --env-file-if-exists=../../.env --import tsx --test test/unit/*.test.ts test/integration/*.test.ts",
    "test:unit": "NODE_ENV=test node --import tsx --test test/unit/*.test.ts",
    "test:integration": "NODE_ENV=test node --env-file-if-exists=../../.env --import tsx --test test/integration/*.test.ts",
    "sync": "tsx --env-file-if-exists=../../.env src/sync/main.ts",
    "operator": "tsx --env-file-if-exists=../../.env src/operator/cli.ts",
    "demo:seed": "tsx --env-file-if-exists=../../.env src/demo/seed.ts",
    "bench": "tsx --env-file-if-exists=../../.env src/bench/routing.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@pewnyszlak/domain": "*",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}