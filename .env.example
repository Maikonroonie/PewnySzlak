# --- Baza danych (Docker Compose) ---
POSTGRES_USER=pewnyszlak
POSTGRES_PASSWORD=pewnyszlak
POSTGRES_DB=pewnyszlak
POSTGRES_PORT=5432

# --- API (uruchamiane lokalnie: npm run dev:api) ---
DATABASE_URL=postgres://pewnyszlak:pewnyszlak@localhost:5432/pewnyszlak
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*
# Token operatora do korekt danych (nagłówek x-operator-token). Puste = narzędzia operatora wyłączone przez HTTP (działa tylko CLI).
OPERATOR_TOKEN=dev-operator-token-change-me
RATE_LIMIT_REPORTS_PER_HOUR=20
RATE_LIMIT_ASSISTANT_PER_HOUR=60

# --- Asystent AI (opcjonalnie; bez klucza działa tryb regułowy) ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Synchronizacja danych ---
OSM_PBF_URL=https://download.geofabrik.de/europe/poland/malopolskie-latest.osm.pbf
DATA_DIR=./data
IMPORTER_CMD=".venv/bin/python services/importer/import_osm.py"
SYNC_OSM_CRON="0 3 * * 1"
SYNC_SOURCES_CRON="30 4 * * *"
NFZ_BENEFITS="PORADNIA REHABILITACYJNA"
ZDYKTY_MCP_URL=https://z-dykty.pl/api/mcp
PSOZ_MCP_URL=https://psoz.pl/api/mcp
NFZ_API_URL=https://api.nfz.gov.pl/app-itl-api

# --- Aplikacja (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
